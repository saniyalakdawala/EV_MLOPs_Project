  "constraints": [
    {
      "name": "charging_ports_pkey",
      "type": "p",
      "table": "charging_ports",
      "definition": "PRIMARY KEY (port_id)"
    },
    {
      "name": "charging_ports_station_id_fkey",
      "type": "f",
      "table": "charging_ports",
      "definition": "FOREIGN KEY (station_id) REFERENCES charging_stations(station_id) ON DELETE CASCADE"
    },
    {
      "name": "chk_connector_type",
      "type": "c",
      "table": "charging_ports",
      "definition": "CHECK (((connector_type)::text = ANY ((ARRAY['CCS-2'::character varying, 'Type 2 AC'::character varying, 'CHAdeMO'::character varying, 'GB/T'::character varying, 'Bharat AC-001'::character varying, 'Bharat DC-001'::character varying])::text[])))"
    },
    {
      "name": "chk_port_status",
      "type": "c",
      "table": "charging_ports",
      "definition": "CHECK (((status)::text = ANY ((ARRAY['AVAILABLE'::character varying, 'IN_USE'::character varying, 'OUT_OF_SERVICE'::character varying, 'MAINTENANCE'::character varying])::text[])))"
    },
    {
      "name": "chk_power_positive",
      "type": "c",
      "table": "charging_ports",
      "definition": "CHECK ((power_kw > 0.0))"
    },
    {
      "name": "uq_station_port_num",
      "type": "u",
      "table": "charging_ports",
      "definition": "UNIQUE (station_id, port_number)"
    },
    {
      "name": "charging_sessions_pkey",
      "type": "p",
