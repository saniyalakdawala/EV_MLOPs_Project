    {
      "name": "charging_sessions_port_id_fkey",
      "type": "f",
      "table": "charging_sessions",
      "definition": "FOREIGN KEY (port_id) REFERENCES charging_ports(port_id) ON DELETE RESTRICT"
    },
    {
      "name": "chk_energy_positive",
      "type": "c",
      "table": "charging_sessions",
      "definition": "CHECK ((energy_kwh >= 0.0))"
    },
    {
      "name": "chk_session_status",
      "type": "c",
      "table": "charging_sessions",
      "definition": "CHECK (((session_status)::text = ANY ((ARRAY['ACTIVE'::character varying, 'COMPLETED'::character varying, 'ABORTED'::character varying])::text[])))"
    },
    {
      "name": "chk_session_times",
      "type": "c",
      "table": "charging_sessions",
      "definition": "CHECK (((end_time IS NULL) OR (end_time >= start_time)))"
    },
    {
      "name": "charging_stations_pkey",
      "type": "p",
      "table": "charging_stations",
      "definition": "PRIMARY KEY (station_id)"
    },
    {
      "name": "chk_latitude_range",
      "type": "c",
      "table": "charging_stations",
      "definition": "CHECK (((latitude >= '-90.0'::numeric) AND (latitude <= 90.0)))"
    },
    {
      "name": "chk_longitude_range",
      "type": "c",
      "table": "charging_stations",
      "definition": "CHECK (((longitude >= '-180.0'::numeric) AND (longitude <= 180.0)))"
    },
    {
